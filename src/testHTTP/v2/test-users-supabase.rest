# Supabase / PostgreSQL — Users API (v2)
# Base: /api/v2/users/pg
#
# IDs in Supabase are UUIDs — replace the placeholder below with a real one
# after running the POST request.
#
# @id = paste-a-real-uuid-here

### Read all users (Supabase)
GET http://localhost:3002/api/v2/users/pg

### Create a new user (Supabase)
POST http://localhost:3002/api/v2/users/pg
Content-Type: application/json

{
    "username": "Alice",
    "role": "admin",
    "email": "alice10@example.com",
    "password": "password123"
}

### Update a user (Supabase)
PUT http://localhost:3002/api/v2/users/pg/faab8c97-f7d0-444e-a30a-8789c91e8856
Content-Type: application/json

{
    "username": "Alice Updated",
    "role": "user"
}

### Delete a user (Supabase)
DELETE http://localhost:3002/api/v2/users/pg/faab8c97-f7d0-444e-a30a-8789c91e8856